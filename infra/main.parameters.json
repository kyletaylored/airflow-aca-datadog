{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "location": {
      "value": "${AZURE_LOCATION}"
    },
    "namePrefix": {
      "value": "${NAME_PREFIX=aflo}"
    },
    "postgresAdminUser": {
      "value": "${POSTGRES_ADMIN_USER=airflowadmin}"
    },
    "postgresSkuName": {
      "value": "${POSTGRES_SKU_NAME=Standard_B1ms}"
    },
    "postgresSkuTier": {
      "value": "${POSTGRES_SKU_TIER=Burstable}"
    },
    "postgresLocation": {
      "value": "${POSTGRES_LOCATION}"
    },
    "postgresZone": {
      "value": "${POSTGRES_ZONE}"
    },
    "postgresAdminPassword": {
      "value": "${POSTGRES_ADMIN_PASSWORD}"
    },
    "airflowAdminUser": {
      "value": "${AIRFLOW_ADMIN_USER=airflow}"
    },
    "airflowAdminPassword": {
      "value": "${AIRFLOW_ADMIN_PASSWORD}"
    },
    "assignJobsRole": {
      "value": "${ASSIGN_JOBS_ROLE=true}"
    },
    "datadogApiKey": {
      "value": "${DD_API_KEY}"
    },
    "datadogSite": {
      "value": "${DD_SITE=datadoghq.com}"
    },
    "datadogEnv": {
      "value": "${DD_ENV=airflow-aca}"
    }
  }
}
