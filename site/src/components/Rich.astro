---
// Plain text with table, column and task names (raw.orders, amount_cents,
// contoso_orders) set as code, so the content files can stay plain strings.
import { splitNames } from "../lib/rich";

interface Props {
  text: string;
}

const parts = splitNames(Astro.props.text);
---

{parts.map((part, i) => (i % 2 === 1 ? <code>{part}</code> : part))}
