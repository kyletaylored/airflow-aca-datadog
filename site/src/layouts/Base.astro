---
import "@datadog/druids/styles.css";
import "../styles/site.css";
import { href } from "../lib/site";

interface Props {
  title: string;
  description: string;
}

const SITE_NAME = "Data Observability with Datadog";
const SITE_TAGLINE = "An introduction to data engineering";
const { title, description } = Astro.props;
const path = Astro.url.pathname;
const pageTitle = `${title} · ${SITE_NAME}`;
// Share cards need absolute URLs.
const canonical = new URL(path, Astro.site).href;
const image = new URL(href("og-image.png"), Astro.site).href;
const imageAlt = "Data Observability with Datadog: monitoring a data pipeline, from the storefront to the dashboards.";
const nav = [
  { label: "Modules", to: "", also: "personas/" },
  { label: "Concepts", to: "concepts/" },
  { label: "Config", to: "config/" },
  { label: "Datadog", to: "tools/" },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{pageTitle}</title>
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={href("favicon.svg")} type="image/svg+xml" />
    <meta name="theme-color" content="#632ca6" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    <meta name="twitter:image:alt" content={imageAlt} />
  </head>
  <body>
    <script is:inline>
      // druids themes on a body class; pick it before the first paint.
      (function () {
        var saved;
        try { saved = localStorage.getItem("personas-theme"); } catch (e) {}
        var dark = saved ? saved === "dark" : matchMedia("(prefers-color-scheme: dark)").matches;
        document.body.classList.add(dark ? "dark-mode" : "light-mode");
      })();
    </script>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="wrap header-inner">
        <a class="brand" href={href()}>
          <span class="brand-mark" aria-hidden="true">D</span>
          <span>
            <strong>{SITE_NAME}</strong>
            <span class="brand-sub">{SITE_TAGLINE}</span>
          </span>
        </a>
        <nav class="site-nav" aria-label="Site">
          {
            nav.map((item) => {
              const target = href(item.to);
              const isCurrent =
                item.to === ""
                  ? path === target || path === `${target}/` || path.startsWith(href(item.also))
                  : path.startsWith(target);
              return (
                <a href={target} aria-current={isCurrent ? "page" : undefined}>
                  {item.label}
                </a>
              );
            })
          }
          <button class="theme-toggle" type="button" role="switch" aria-checked="false" aria-label="Dark theme">
            <span class="theme-toggle-track" aria-hidden="true">
              <svg class="theme-icon theme-icon-sun" viewBox="0 0 16 16" width="12" height="12">
                <circle cx="8" cy="8" r="3" fill="currentColor" />
                <path d="M8 1v1.5M8 13.5V15M1 8h1.5M13.5 8H15M3.05 3.05l1.06 1.06M11.89 11.89l1.06 1.06M3.05 12.95l1.06-1.06M11.89 4.11l1.06-1.06" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
              </svg>
              <svg class="theme-icon theme-icon-moon" viewBox="0 0 16 16" width="12" height="12">
                <path d="M13.5 9.6A5.5 5.5 0 0 1 6.4 2.5a5.5 5.5 0 1 0 7.1 7.1Z" fill="currentColor" />
              </svg>
              <span class="theme-toggle-thumb"></span>
            </span>
          </button>
        </nav>
      </div>
    </header>
    <main id="main" class="wrap">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap">
        Built from the demo in{" "}
        <a href="https://github.com/kyletaylored/airflow-aca-datadog">kyletaylored/airflow-aca-datadog</a>.
        Contoso Outfitters is a fictional company. Progress is saved in this browser only.
      </div>
    </footer>
    <script is:inline>
      (function () {
        var toggle = document.querySelector(".theme-toggle");
        var sync = function () {
          toggle.setAttribute("aria-checked", String(document.body.classList.contains("dark-mode")));
        };
        sync();
        toggle.addEventListener("click", function () {
          var dark = !document.body.classList.contains("dark-mode");
          document.body.classList.toggle("dark-mode", dark);
          document.body.classList.toggle("light-mode", !dark);
          sync();
          try { localStorage.setItem("personas-theme", dark ? "dark" : "light"); } catch (e) {}
        });
      })();
    </script>
  </body>
</html>
