---
import { Text } from "@datadog/druids/typography/Text";
import Base from "../../layouts/Base.astro";
import { conceptLessons, glossary } from "../../data/concepts";
import { href } from "../../lib/site";
---

<Base
  title="Data engineering concepts"
  description="The terms observability and data engineering share, the rationale for distributed data pipelines, the medallion architecture, the data tool landscape grouped by function, and the two kinds of telemetry Airflow sends to Datadog."
>
  <section class="hero hero-compact">
    <Text as="p" size="sm" variant="tertiary" weight="bold" textTransform="uppercase">Background</Text>
    <Text as="h1" size="xxl" weight="bold">Data engineering concepts</Text>
    <Text as="p" size="lg" variant="secondary" className="lede">
      The persona modules assume familiarity with five topics: the terms observability and data engineering share, the rationale for building a data pipeline, the layered structure of a warehouse, the purpose of the major data products, and the difference between lineage events and traces. These lessons cover each topic.
    </Text>
  </section>

  <section>
    <div class="card-grid">
      {
        conceptLessons.map((l, i) => (
          <a class="card persona-card" href={href(`concepts/${l.slug}/`)}>
            <div class="card-header">
              <div>
                <Text as="p" size="xs" variant="tertiary" textTransform="uppercase" weight="bold">
                  Concept {i + 1}
                </Text>
                <Text as="h2" size="lg" weight="bold">
                  {l.title}
                </Text>
              </div>
            </div>
            <div class="card-body">
              <Text as="p" variant="secondary">
                {l.summary}
              </Text>
            </div>
            <div class="card-footer">
              <span class="card-cta">Read the lesson →</span>
            </div>
          </a>
        ))
      }
    </div>
  </section>

  <section class="lesson">
    <Text as="h2" size="lg" weight="bold">Glossary</Text>
    <dl class="benefits glossary">
      {
        glossary.map((g) => (
          <>
            <dt>{g.term}</dt>
            <dd>{g.meaning}</dd>
          </>
        ))
      }
    </dl>
  </section>
</Base>
