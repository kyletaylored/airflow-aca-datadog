---
import { Text } from "@datadog/druids/typography/Text";
import ConceptPager from "../../components/ConceptPager.astro";
import Diagram from "../../components/Diagram.astro";
import Rich from "../../components/Rich.astro";
import type { FlowEdge, FlowNode } from "../../components/FlowDiagram.tsx";
import Base from "../../layouts/Base.astro";
import { conceptPosition } from "../../data/concepts";
import { href } from "../../lib/site";

const oneDbNodes: FlowNode[] = [
  { id: "app", label: "Storefront", sub: "the web shop", x: 0, y: 100, tone: "app", detail: { text: "Writes each order directly to the database during checkout. This design is simple and appropriate for a small business." } },
  { id: "db", label: "Orders database", sub: "PostgreSQL or SQL Server", x: 260, y: 100, tone: "store", width: 200, detail: { text: "Checkout, reporting, exports and other services all read from and write to this database. Each additional reader adds load to the system that accepts orders, so a slow report can degrade checkout." } },
  { id: "dash", label: "Dashboards", sub: "scan the live tables", x: 560, y: 0, tone: "serve", detail: { text: "Analytical queries read months of orders at once. On a row-oriented database tuned for checkout, these queries are slow and compete with the application for CPU, memory and locks." } },
  { id: "finance", label: "Finance export", sub: "nightly CSV", x: 560, y: 110, tone: "serve", detail: { text: "Each export is custom code written against the application's tables. Renaming a column for the application breaks the export, and the failure is often discovered only at month end." } },
  { id: "email", label: "Email service", sub: "polls for new orders", x: 560, y: 220, tone: "app", detail: { text: "Polling the orders table every few seconds adds further load and couples the email service to the storefront's schema." } },
];
const oneDbEdges: FlowEdge[] = [
  { from: "app", to: "db", label: "writes" },
  { from: "db", to: "dash", label: "heavy scans" },
  { from: "db", to: "finance", label: "exports" },
  { from: "db", to: "email", label: "polling" },
];

const pipeNodes: FlowNode[] = [
  { id: "app", label: "Storefront", sub: "publishes order events", x: 0, y: 0, tone: "app", detail: { text: "Checkout publishes one event per order and continues. The storefront has no knowledge of its readers, and it continues to accept orders when a reader is unavailable." } },
  { id: "topic", label: "orders topic", sub: "event stream", x: 250, y: 0, tone: "stream", detail: { text: "Retains every order event for a defined period. Each reader tracks its own position, so a new reader can begin from earlier events and a failed reader can resume after it is repaired." } },
  { id: "proc", label: "Order processor", sub: "validates, batches", x: 500, y: 0, tone: "process", detail: { text: "Converts the stream into files every few minutes. It commits its position only after a file is written, so a crash causes a batch to be replayed rather than lost." } },
  { id: "lake", label: "Landing zone", sub: "files by date and hour", x: 750, y: 0, tone: "store", detail: { text: "Raw files in low-cost storage, retained as they arrived. If a transformation proves incorrect, the warehouse can be rebuilt from these files." } },
  { id: "dw", label: "Warehouse", sub: "raw → staging → marts", x: 750, y: 170, tone: "store", width: 190, detail: { text: "A separate analytical store, rebuilt every 15 minutes by the orchestrator. Heavy queries run here and never against the storefront's database." } },
  { id: "bi", label: "Dashboards", sub: "read the marts", x: 500, y: 170, tone: "serve", detail: { text: "Read clean, modeled tables with agreed definitions, rather than depending on the application's internal schema." } },
  { id: "email", label: "Email service", sub: "its own subscription", x: 250, y: 170, tone: "muted", detail: { text: "An additional reader of the same events, with its own position. Adding it requires no change to the storefront or the warehouse. (Illustrative; not part of this demo.)" } },
  { id: "fraud", label: "Fraud check", sub: "reacts in seconds", x: 0, y: 170, tone: "muted", detail: { text: "Streaming allows some readers to react in near real time while the warehouse loads in batches. (Illustrative; not part of this demo.)" } },
];
const pipeEdges: FlowEdge[] = [
  { from: "app", to: "topic", label: "per order" },
  { from: "topic", to: "proc" },
  { from: "proc", to: "lake", label: "every 5 min" },
  { from: "lake", to: "dw", label: "every 15 min", fromSide: "bottom", toSide: "top" },
  { from: "dw", to: "bi", fromSide: "left", toSide: "right" },
  { from: "topic", to: "email", dashed: true, fromSide: "bottom", toSide: "top" },
  { from: "topic", to: "fraud", dashed: true, fromSide: "bottom", toSide: "top" },
];
---

<Base
  title="The case for a distributed pipeline"
  description="A single shared database compared with a distributed, event-driven pipeline: the benefits of the additional components, and their costs."
>
  <a class="back-link" href={href("concepts/")}>← All concepts</a>
  <article class="concept">
    <header class="hero hero-compact">
      <Text as="p" size="sm" variant="tertiary" weight="bold" textTransform="uppercase">{conceptPosition("why-pipelines")}</Text>
      <Text as="h1" size="xxl" weight="bold">The case for a distributed pipeline</Text>
      <Text as="p" size="lg" variant="secondary" className="lede">
        Contoso could write every order to a single database and connect its dashboards directly to it. Many companies
        begin with that design, and for some it remains the right one. This lesson describes what changes as a business
        grows, and explains the structure of the demo's pipeline.
      </Text>
    </header>

    <section class="lesson">
      <Text as="h2" size="lg" weight="bold">The baseline: a single shared database</Text>
      <Text as="p">
        The storefront writes orders to its database, and every other consumer reads from the same place. Select a box to
        see where the strain appears.
      </Text>
      <Diagram nodes={oneDbNodes} edges={oneDbEdges} height={320} initial="db" />
      <Text as="p">
        This design holds up only to a point. A database that accepts orders is tuned for many small, fast transactions
        (OLTP). A dashboard that sums a year of orders requires the opposite: large scans and aggregates (OLAP). When both
        workloads share one server, reporting slows checkout, every new consumer depends on the application's tables, and
        no record remains of the data's state before the most recent faulty update.
      </Text>
    </section>

    <section class="lesson">
      <Text as="h2" size="lg" weight="bold">The distributed model: one responsibility and one owner per step</Text>
      <Text as="p">
        The demo follows this model. The storefront publishes each order as an event, and independent readers process it
        from there. Dashed boxes represent readers a company might add later; they are not part of the demo.
      </Text>
      <Diagram nodes={pipeNodes} edges={pipeEdges} height={340} initial="topic" />
    </section>

    <section class="lesson">
      <Text as="h2" size="lg" weight="bold">Benefits of the additional components</Text>
      <dl class="benefits">
        <dt>Application performance is protected</dt>
        <dd>Analytical queries run on a separate warehouse designed for them, never on the database that accepts orders.</dd>
        <dt>Producers and consumers are decoupled</dt>
        <dd>
          The storefront publishes each event once. Adding a reader (email, fraud detection, a new warehouse) requires a new
          subscription rather than a change to the storefront, and an unavailable reader does not interrupt checkout.
        </dd>
        <dt>Data is retained and can be replayed</dt>
        <dd>
          The stream retains events for a defined period, and the landing zone retains every raw file. A defect in a
          transformation is corrected by rebuilding from the raw data, without requesting that the storefront resend it.
        </dd>
        <dt>Each team owns one step</dt>
        <dd>
          Dave owns the order event, Emily the loads, Rajesh the schemas, Priya the business logic and John the reports.
          Each step hands off through a contract (a message format, a table, the meaning of a column), so each team can
          change its own step without coordinating every release.
        </dd>
        <dt>Each step scales independently</dt>
        <dd>
          Storage is inexpensive and separate from compute. A slow mart build receives additional compute without affecting
          ingestion, and a traffic spike is absorbed by the stream rather than overwhelming the warehouse.
        </dd>
        <dt>Real-time and batch processing coexist</dt>
        <dd>
          The same events can feed a fraud check within seconds and the warehouse every 15 minutes.
        </dd>
      </dl>
    </section>

    <section class="lesson">
      <Text as="h2" size="lg" weight="bold">Costs and trade-offs</Text>
      <ul class="ticks">
        <li><Rich text="More components, operated by more people: a stream, a processor, storage, an orchestrator, a warehouse and a BI tool, each of which can fail independently." /></li>
        <li><Rich text="Latency: the demo's dashboards trail checkout by up to approximately 20 minutes, whereas the single-database design was live." /></li>
        <li><Rich text="Failures become less visible. A run can succeed while loading nothing, a schema change two steps upstream can break a report, and a logic defect can produce plausible but incorrect figures." /></li>
        <li><Rich text="Contracts require ongoing attention. A field the storefront removes appears as nulls in a mart a day later, in a step owned by a different team." /></li>
      </ul>
      <div class="callout">
        <Text as="p" weight="bold">The role of observability</Text>
        <Text as="p">
          The distributed model replaces one conspicuous failure (a slow database) with many less visible failures spread
          across teams. Each persona module examines one of them: Datadog must identify which step failed, which team owns
          it, and which downstream assets it affects. See the <a href={href()}>persona modules</a>.
        </Text>
      </div>
      <Text as="p" size="sm" variant="secondary">
        As a general guideline, begin with a single database and a read replica for reporting. Adopt a pipeline when
        reporting degrades application performance, when several teams require the same data in different forms, or when
        history and replay become requirements.
      </Text>
    </section>

    <ConceptPager slug="why-pipelines" />
  </article>
</Base>
