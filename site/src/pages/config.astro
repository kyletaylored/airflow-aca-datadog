---
import { Text } from "@datadog/druids/typography/Text";
import Clicks from "../components/Clicks.astro";
import Rich from "../components/Rich.astro";
import ToolTag from "../components/ToolTag.astro";
import DocsLink from "../components/DocsLink.astro";
import Base from "../layouts/Base.astro";
import { notNeeded, configGroups, sourceUrl } from "../data/config";

let n = 0;
const numbered = configGroups.map((g) => ({ ...g, steps: g.steps.map((s) => ({ ...s, n: ++n })) }));
---

<Base
  title="Config"
  description="What each Datadog product needs in this demo: Data Jobs Monitoring and APM for Airflow on Azure Container Apps, then Data Observability, Database Monitoring and Data Streams Monitoring for the warehouse and order stream."
>
  <section class="hero hero-compact">
    <Text as="h1" size="xxl" weight="bold">Config</Text>
    <Text as="p" size="lg" variant="secondary" className="lede">
      Each product needs a few settings. Start with Data Jobs Monitoring, and add the others when you need what they show. Values in angle brackets are your own. Where a setting can also be made in the Azure portal, its card has a Code and an Azure portal tab.
    </Text>
    <ol class="config-index">
      {numbered.flatMap((g) => g.steps).map((s) => <li><a href={`#${s.id}`}>{s.name}</a></li>)}
    </ol>
  </section>

  <script is:inline>
    (() => {
      const root = document.documentElement;
      let view = "code";
      try { view = localStorage.getItem("config-view") || "code"; } catch (e) {}
      root.dataset.configView = view;
      const sync = () =>
        document.querySelectorAll("[data-view-button]").forEach((b) => b.setAttribute("aria-pressed", String(b.dataset.viewButton === root.dataset.configView)));
      document.addEventListener("DOMContentLoaded", sync);
      document.addEventListener("click", (e) => {
        const b = e.target.closest("[data-view-button]");
        if (!b) return;
        root.dataset.configView = b.dataset.viewButton;
        try { localStorage.setItem("config-view", b.dataset.viewButton); } catch (e) {}
        sync();
      });
    })();
  </script>

  {
    numbered.map((group) => (
      <section class="config-group">
        <div class="section-head">
          <Text as="h2" size="lg" weight="bold">{group.title}</Text>
          <Text as="p" variant="secondary">{group.intro}</Text>
        </div>
        <div class="config-steps">
          {group.steps.map((step) => (
            <article class="card config-card" id={step.id}>
              <div class="card-header">
                <span class="config-number">{step.n}</span>
                {step.tool ? <ToolTag tool={step.tool} size="md" /> : <Text as="span" weight="bold">{step.name}</Text>}
                <DocsLink href={step.docs} name={step.name} />
              </div>
              <div class="card-body">
                <Text as="p" weight="bold"><Rich text={step.gives} /></Text>
                <Text as="p" size="sm" variant="secondary"><Rich text={step.where} /></Text>
                {step.snippets.some((s) => s.portal) && (
                  <div class="config-view" role="group" aria-label="Show the steps as">
                    <button type="button" data-view-button="code" aria-pressed="true">Code</button>
                    <button type="button" data-view-button="portal" aria-pressed="false">Azure portal</button>
                  </div>
                )}
                {step.snippets.map((s) => (
                  <>
                    {s.portal && (
                      <figure class="example config-portal" data-pane="portal">
                        <figcaption>{s.label}, in the Azure portal</figcaption>
                        <ol class="config-portal-steps">{s.portal.map((t) => <li><Clicks text={t} /></li>)}</ol>
                      </figure>
                    )}
                    <figure class="example" data-pane={s.portal && !s.values ? "code" : undefined}>
                      <figcaption>{s.label}</figcaption>
                      <pre><code>{s.code}</code></pre>
                    </figure>
                  </>
                ))}
                {step.steps && <ol class="ticks config-clicks">{step.steps.map((t) => <li>{t}</li>)}</ol>}
                {step.note && <p class="config-note"><Rich text={step.note} /></p>}
              </div>
              <div class="card-footer">
                <Text as="span" size="sm" variant="tertiary">
                  In this repo: <a href={sourceUrl(step.source.path)}>{step.source.label}</a>
                </Text>
              </div>
            </article>
          ))}
        </div>
      </section>
    ))
  }

  <section class="callout">
    <Text as="p" weight="bold">What you don't need</Text>
    <ul class="ticks">{notNeeded.map((t) => <li>{t}</li>)}</ul>
  </section>
</Base>
