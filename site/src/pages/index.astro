---
import { Text } from "@datadog/druids/typography/Text";
import PersonaCard from "../components/PersonaCard.astro";
import Pipeline from "../components/Pipeline.astro";
import Stats from "../components/Stats.tsx";
import Base from "../layouts/Base.astro";
import { personas } from "../data/personas";
import { tools } from "../data/tools";
import { href } from "../lib/site";

const stats = [
  { value: personas.length, label: "Personas" },
  { value: tools.length, label: "Datadog tools" },
  { value: 15, unit: "min", label: "Between pipeline runs" },
];
---

<Base
  title="Monitoring a data pipeline"
  description="A self-paced course on monitoring data pipelines using Data Observability with Datadog. Built on Azure with Airflow, PostgreSQL and Azure Container Apps."
>
  <section class="hero">
    <Text as="p" size="sm" variant="tertiary" weight="bold" textTransform="uppercase">
      Contoso Outfitters · Data pipeline
    </Text>
    <Text as="h1" size="xxl" weight="bold">Monitoring a data pipeline</Text>
    <Text as="p" size="lg" variant="secondary" className="lede">
      Contoso sells outdoor and travel equipment online and through seven retail stores. Every order passes from the
      storefront, through Event Hubs and a landing zone, into a PostgreSQL warehouse that Airflow rebuilds every 15
      minutes. Five people operate that pipeline. Each module follows one of them, covering the components they own,
      the incident that occurs in their area, and the Datadog products that detect it and identify its cause.
    </Text>
    <Stats client:only="react" stats={stats}>
      <ul slot="fallback" class="stats stats-fallback">
        {stats.map((s) => <li><strong>{s.value}{s.unit ? ` ${s.unit}` : ""}</strong> {s.label}</li>)}
      </ul>
    </Stats>
  </section>

  <section aria-labelledby="pipeline-heading">
    <div class="section-head">
      <Text as="h2" size="lg" weight="bold" id="pipeline-heading">The order flow and the owner of each step</Text>
      <Text as="p" variant="secondary">
        An order reaches the dashboards within approximately 20 minutes of checkout. Each step is colored by its owner and
        labeled with the Datadog products that monitor it. Select a step to view its details.
      </Text>
    </div>
    <Pipeline height={600} initial="storefront" />
  </section>

  <section aria-labelledby="modules-heading">
    <div class="section-head">
      <Text as="h2" size="lg" weight="bold" id="modules-heading">Modules</Text>
      <Text as="p" variant="secondary">
        Each module takes approximately 10 minutes and can be completed in any order; John's module connects the others.
      </Text>
    </div>
    <div class="card-grid">
      {personas.map((persona, index) => <PersonaCard persona={persona} index={index} />)}
    </div>
  </section>

  <section class="callout-band">
    <div>
      <Text as="h2" size="lg" weight="bold">Data engineering concepts</Text>
      <Text as="p" variant="secondary">
        The rationale for distributed pipelines, the medallion architecture, and the data tool landscape grouped by function.
      </Text>
    </div>
    <a class="button-link" href={href("concepts/")}>Read the concepts</a>
  </section>

  <section class="callout-band">
    <div>
      <Text as="h2" size="lg" weight="bold">The Datadog products</Text>
      <Text as="p" variant="secondary">
        A reference page for each product, describing the question it answers and the data it observes in this demo.
      </Text>
    </div>
    <a class="button-link" href={href("tools/")}>View the products</a>
  </section>
</Base>
